# ==========================================
# Ristorante Il Veliero — Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your private variables before starting.
# NEVER commit the real .env file to public version control.

# --- Environment & Ports ---
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=http://localhost:4200

# --- Database Configuration ---
MONGODB_URI=mongodb://database:27017/ilveliero
MONGODB_CONNECT_TIMEOUT_MS=5000
AUTO_SEED_IF_EMPTY=true

# --- Security & JWT Authentication ---
# In production, replace with a strong, cryptographically secure random string (min 64 chars)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
MASTER_EMERGENCY_KEY=your_emergency_override_key_here

# --- Default Seed Accounts & Master Access ---
# Master admin accounts that cannot be deleted or locked
MASTER_ADMIN_EMAILS=admin@ilveliero.it

# Initial seed credentials (used only on first startup if database is empty)
ADMIN_DEFAULT_EMAIL=admin@ilveliero.it
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword123!

GESTORE_DEFAULT_USERNAME=gestore_veliero
GESTORE_DEFAULT_EMAIL=gestore@ilveliero.it
GESTORE_DEFAULT_PASSWORD=GestoreSecurePassword123!

CLIENT_DEFAULT_EMAIL=cliente@ilveliero.it
CLIENT_DEFAULT_PASSWORD=ClientSecurePassword123!

# --- File Storage & Upload Limits ---
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5
