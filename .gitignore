# ==========================================
# Ristorante Il Veliero — Git Ignore Configuration
# ==========================================

# 1. Environment & Sensitive Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# 2. Secret Keys, Certificates & Auth Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub

# 3. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
*/node_modules/

# 4. Build & Compilation Artifacts
dist/
backend/dist/
frontend/dist/
build/
out/
.angular/
frontend/.angular/
.cache/

# 5. Runtime Uploads & Database Data
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
mongo_data/
*.sqlite
*.db

# 6. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 7. Temporary & Scratch Files
scratch/
.system_generated/
.agents/
tmp/
temp/
*.tmp

# 8. Large Video Clips & Raw Screen Recordings
materiale_utile/clip/*.mp4
materiale_utile/clip/*.mov
materiale_utile/clip/*.avi

# 9. IDE, Editor & OS Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
