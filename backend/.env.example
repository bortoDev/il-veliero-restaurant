# ==========================================
# Il Veliero Backend Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# Database Configuration
# In development/testing, if local MongoDB is not reachable, MongoMemoryServer is spawned automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/ilveliero
MONGODB_CONNECT_TIMEOUT_MS=2500
MONGODB_AUTO_MEMORY_FALLBACK=true

# Security & Authentication
JWT_SECRET=il_veliero_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
MASTER_EMERGENCY_KEY=EMERGENCY_KEY_VELIERO_2026_MASTER_OVERRIDE_BASSANO
MASTER_ADMIN_EMAILS=bortolatofilippo05@gmail.com,pizzadalcampione@gmail.com

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Default Seed Credentials
ADMIN_DEFAULT_EMAIL=bortolatofilippo05@gmail.com
ADMIN_DEFAULT_PASSWORD=AdminPass123!
GESTORE_DEFAULT_USERNAME=gestore_veliero
GESTORE_DEFAULT_EMAIL=gestore@ilveliero.it
GESTORE_DEFAULT_PASSWORD=GestorePass123!
CLIENT_DEFAULT_EMAIL=cliente@ilveliero.it
CLIENT_DEFAULT_PASSWORD=ClientPass123!
