# ==========================================
# Il Veliero Backend Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your private variables before starting.
# NEVER commit the real .env file to public version control.

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# Database Configuration
MONGO_ROOT_USER=your_db_username_here
MONGO_ROOT_PASSWORD=your_db_strong_password_here
MONGODB_URI=mongodb://127.0.0.1:27017/ilveliero
MONGODB_CONNECT_TIMEOUT_MS=2500
MONGODB_AUTO_MEMORY_FALLBACK=true

# Security & Authentication (Replace in production with cryptographically secure random keys, min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
MASTER_EMERGENCY_KEY=your_emergency_master_override_key_min_32_characters_here
MASTER_ADMIN_EMAILS=admin@ilveliero.it

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Default Initial Seed Credentials (used only if database is completely empty)
ADMIN_DEFAULT_EMAIL=admin@ilveliero.it
ADMIN_DEFAULT_PASSWORD=ReplaceWithStrongPassword123!
GESTORE_DEFAULT_USERNAME=gestore_veliero
GESTORE_DEFAULT_EMAIL=gestore@ilveliero.it
GESTORE_DEFAULT_PASSWORD=ReplaceWithStrongPassword123!
CLIENT_DEFAULT_EMAIL=cliente@ilveliero.it
CLIENT_DEFAULT_PASSWORD=ReplaceWithStrongPassword123!
