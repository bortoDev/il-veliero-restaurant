<!-- Video media descriptor & placeholder container for Hero Ocean Loop -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="100%" height="100%">
  <defs>
    <linearGradient id="oceanLoop" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#07192f"/>
      <stop offset="50%" stop-color="#134074"/>
      <stop offset="100%" stop-color="#030c17"/>
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#oceanLoop)"/>
  <path d="M0,800 Q480,720 960,800 T1920,780 L1920,1080 L0,1080 Z" fill="#0b2545" opacity="0.8"/>
  <text x="960" y="540" font-family="sans-serif" font-size="36" fill="#dda15e" text-anchor="middle">Hero Ocean Video Stream</text>
</svg>
